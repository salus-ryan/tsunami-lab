{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salus-ryan.github.io/tsunami-lab/schemas/report.schema.json",
  "title": "Tsunami Lab result report",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "reportFormatVersion", "product", "version", "exportedAt", "disclaimer", "deployment", "model", "scenario", "simulationTimeSeconds", "coastalWatch"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "reportFormatVersion": { "const": 1 },
    "product": { "type": "string" },
    "version": { "type": "string" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "disclaimer": { "type": "string" },
    "deployment": { "type": "object" },
    "model": { "type": "object" },
    "scenario": { "$ref": "./scenario.schema.json" },
    "simulationTimeSeconds": { "type": "number", "minimum": 0, "maximum": 172800 },
    "coastalWatch": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "latitude", "longitude", "centralWaveM", "ensembleMinimumM", "ensembleMaximumM", "firstSignalSeconds"],
        "properties": {
          "name": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "centralWaveM": { "type": "number", "minimum": 0 },
          "ensembleMinimumM": { "type": "number", "minimum": 0 },
          "ensembleMaximumM": { "type": "number", "minimum": 0 },
          "firstSignalSeconds": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    }
  }
}
