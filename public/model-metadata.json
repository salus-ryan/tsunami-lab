{
  "schemaVersion": 1,
  "modelId": "tsunami-lab-swe-1deg",
  "modelVersion": "1.1.0",
  "solver": {
    "name": "Staggered linear shallow-water mass/momentum solver",
    "grid": { "projection": "equirectangular", "width": 360, "height": 160, "latitudeMinimum": -80, "latitudeMaximum": 80, "nominalResolutionDegrees": 1 },
